# Run npm run setup to create private .env.server.local with a random admin key.
# Secrets belong in .env.server.local or server environment, never VITE_*.
ADMIN_API_TOKEN=
AI_PROVIDER=ollama
AI_MODEL=qwen3:4b
# AI_BASE_URL=http://127.0.0.1:11434
# Optional direct provider mode: AI_PROVIDER=polza
# AI_BASE_URL=https://api.polza.ai/api/v1
# AI_MODEL=openai/gpt-4o-mini
# POLZA_AI_API_KEY=
# Optional DB_PATH=/absolute/private/path/site.sqlite
# Optional HOST=127.0.0.1 PORT=3000
