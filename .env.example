# Public server addresses only. Never put keys/passwords in VITE_* variables.
VITE_DATA_API_URL=
VITE_AI_API_URL=
VITE_SERVICES_API_URL=

# Server environment (configure these in the function hosting dashboard):
# ADMIN_API_TOKEN=<random secret of at least 32 characters>
# DATABASE_URL=<PostgreSQL connection string>
# GITHUB_TOKEN=<optional token scoped to your repository for CSV sync>
# GITHUB_REPO_OWNER=Scorboc
# GITHUB_REPO_NAME=bmw-coding-site
# POLZA_AI_API_KEY=<AI provider key; check backend function requirements>
